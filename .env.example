# Bingeo production configuration
NODE_ENV=production
PORT=3000

# Public infrastructure
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
BINGEO_BASE_URL=https://www.seudominio.com.br

# Server-only secrets — never commit real values
SUPABASE_SECRET_KEY=sb_secret_xxx
ASAAS_API_KEY=$aact_xxx
ASAAS_WEBHOOK_TOKEN=generate_a_random_32_plus_character_token
BINGEO_AUDIT_SALT=generate_a_random_secret

# Asaas: sandbox during homologation; production only after tests
ASAAS_ENV=sandbox
BINGEO_PRO_MONTHLY_PRICE=14.90

# Supplier information required before enabling paid checkout
BINGEO_LEGAL_NAME=
BINGEO_LEGAL_TAX_ID=
BINGEO_LEGAL_ADDRESS=
BINGEO_SUPPORT_EMAIL=
BINGEO_PRIVACY_EMAIL=

# Content providers
TMDB_READ_TOKEN=
THETVDB_API_KEY=
THETVDB_PIN=
